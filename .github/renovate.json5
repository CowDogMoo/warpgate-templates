{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>CowDogMoo/renovate-config',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Update WARPGATE_VERSION environment variable in workflows',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        'WARPGATE_VERSION:\\s*["\']?(?<currentValue>v?[0-9.]+)["\']?',
      ],
      depNameTemplate: 'CowDogMoo/warpgate',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
  ],
}
